// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  // Papel no painel: "owner" (titular — gerencia a equipe) | "editor" (acesso
  // ao conteúdo, mas não à gestão de usuários). Membros criados pelo painel
  // nascem "editor"; a conta principal é "owner". Ver /admin/equipe.
  role      String   @default("editor")
  // MFA (TOTP): opt-in por usuário. `totpSecret` (Base32) é gravado no início da
  // ativação (mfaEnabled=false) e só passa a valer quando `mfaEnabled` vira true
  // (após o usuário confirmar um código do app). Login exige OTP apenas quando
  // mfaEnabled=true — default false: nada muda para quem não ativou.
  totpSecret String?
  mfaEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  image       String?
  // Onde exibir a imagem de destaque: "popup" (dentro do modal, padrão) ou
  // "external" (ao lado da proposta, no card da página /propostas).
  imagePlacement String @default("popup")
  description String
  problem     String
  objective   String
  solution    String
  goals       String
  benefits    String
  faq         String?
  // Proposta completa em mini-markdown (## título, - lista, **negrito**),
  // exibida no modal "Ver proposta completa".
  content     String?
  // Proposta PRINCIPAL (card grande no topo) vs TEMA (card quadrado). Escolha
  // explícita no painel — antes era inferido pela presença de `content`.
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  image       String?
  source      String
  url         String?
  summary     String
  // Moderação: "approved" (visível no site) | "pending" (aguardando revisão) |
  // "rejected". Notícias criadas manualmente no admin nascem "approved"; as
  // ingeridas dos feeds nascem "pending" e só vão ao ar após aprovação.
  status      String   @default("approved")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  // Dedupe da ingestão consulta por url (findFirst) — índice evita full scan
  // com milhares de notícias. Não é @unique de propósito (url é opcional e a
  // corrida é mitigada no código); vira índice simples.
  @@index([url])
}

// Galeria de mídia gerida pelo admin (guia "Mídia"). Uma linha por foto ou
// vídeo. `type` = "photo" | "video". Foto: `src` é /uploads/... (upload local
// otimizado) ou uma URL externa. Vídeo: `src` é a URL do embed (YouTube etc.)
// e `poster` uma miniatura opcional. `order` controla a ordenação manual e
// `published` esconde do site sem apagar. A página pública /galeria lê daqui.
model Media {
  id        String   @id @default(cuid())
  type      String   @default("photo")
  title     String?
  src       String
  poster    String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, published, order])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  cpf       String?
  email     String
  phone     String
  city      String
  message   String
  // Notificação: mensagens nascem NÃO lidas (read=false). O painel mostra o
  // total de não lidas como badge na navegação e um selo "Nova" em cada uma.
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // O badge de notificação consulta count({ where: { read: false } }) a cada
  // render do painel — índice evita full scan conforme as mensagens acumulam.
  @@index([read])
}

// Pedidos de adesivo feitos pela página pública /adesivos. Entregamos se
// estivermos na cidade; caso contrário, a retirada é com o apoiador responsável
// da cidade (a equipe organiza pelo painel).
model StickerRequest {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  city      String
  address   String
  quantity  Int      @default(1)
  // Pedidos nascem NÃO entregues (delivered=false). O painel mostra o total de
  // pendentes como badge e um selo "Novo" em cada pedido.
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  // O badge conta count({ where: { delivered: false } }) a cada render do
  // painel — índice evita full scan conforme os pedidos acumulam.
  @@index([delivered])
}

// Líderes/apoiadores por cidade — a página /adesivos mostra um mapa de MT e, ao
// clicar numa cidade, leva ao WhatsApp do líder responsável por entregar os
// adesivos ali. `status`: "active" (aparece no mapa) | "pending" (cadastro
// feito pelo próprio apoiador em "Quero ser líder", aguardando aprovação). O
// `cityCode` é o código IBGE (7 dígitos) do município, usado para casar com a
// malha do mapa de forma confiável (nomes variam em acento/grafia).
model Leader {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  city      String
  cityCode  String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([cityCode])
}

// Conteúdo editável do site (seção "Por que", bio, trajetória, comenda e listas
// de formação/reconhecimentos). Registro ÚNICO (id fixo "main") com um documento
// JSON — o admin edita pela aba "Conteúdo" e as páginas leem daqui, caindo nos
// valores padrão (DEFAULT_CONTENT em @/lib/site-content) quando a linha não existe.
model SiteContent {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
