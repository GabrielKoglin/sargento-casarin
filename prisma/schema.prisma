// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  image       String?
  description String
  problem     String
  objective   String
  solution    String
  goals       String
  benefits    String
  faq         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  image       String?
  source      String
  url         String?
  summary     String
  // Moderação: "approved" (visível no site) | "pending" (aguardando revisão) |
  // "rejected". Notícias criadas manualmente no admin nascem "approved"; as
  // ingeridas dos feeds nascem "pending" e só vão ao ar após aprovação.
  status      String   @default("approved")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  // Dedupe da ingestão consulta por url (findFirst) — índice evita full scan
  // com milhares de notícias. Não é @unique de propósito (url é opcional e a
  // corrida é mitigada no código); vira índice simples.
  @@index([url])
}

// Galeria de mídia gerida pelo admin (guia "Mídia"). Uma linha por foto ou
// vídeo. `type` = "photo" | "video". Foto: `src` é /uploads/... (upload local
// otimizado) ou uma URL externa. Vídeo: `src` é a URL do embed (YouTube etc.)
// e `poster` uma miniatura opcional. `order` controla a ordenação manual e
// `published` esconde do site sem apagar. A página pública /galeria lê daqui.
model Media {
  id        String   @id @default(cuid())
  type      String   @default("photo")
  title     String?
  src       String
  poster    String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, published, order])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  city      String
  message   String
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
