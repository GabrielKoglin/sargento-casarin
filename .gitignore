# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# uploads de mídia (não versionar; manter só o placeholder do diretório)
public/uploads/*
!public/uploads/.gitkeep

# banco local (SQLite)
*.db
*.db-journal

# material de referência do template (não versionar)
/_reference/

# relatórios internos de auditoria (artefatos de processo)
/.reports/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
