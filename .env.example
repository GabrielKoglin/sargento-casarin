# ============================================================================
# .env.example — modelo das variáveis de ambiente (SEM valores reais)
# ============================================================================
# Copie para `.env` e preencha com os valores reais. O `.env` é ignorado pelo
# Git (contém SEGREDOS) — NUNCA comite o .env preenchido.
#
# ⚠️  Ao formatar a máquina, faça BACKUP do seu .env real (pen drive / Drive /
#     gerenciador de senhas). Ele NÃO está no GitHub de propósito.

# --- Banco de dados (Supabase Postgres) -------------------------------------
# DATABASE_URL = conexão via POOLER (porta 6543, pgbouncer) — usada pelo app.
# DIRECT_URL   = conexão DIRETA (porta 5432) — usada pelo CLI (prisma db push).
# Pegue as duas em: Supabase > Project > Settings > Database > Connection string.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (upload de imagens) -----------------------------------
# SUPABASE_URL             = URL do projeto (ex.: https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY= chave service_role (Settings > API). É SECRETA.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_key_secreta"

# --- Sessão / segurança -----------------------------------------------------
# AUTH_SECRET = assina os JWTs da sessão admin. Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRON_SECRET = protege /api/cron/ingest-news. Gere outro valor INDEPENDENTE.
AUTH_SECRET="gere_um_valor_aleatorio_forte"
CRON_SECRET="gere_outro_valor_aleatorio_forte"

# --- Admin inicial (usado por `npm run create-admin`) -----------------------
ADMIN_EMAIL="admin@sargentocasarinmt.com.br"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="senha_forte_do_admin"

# --- Opcional: assistente de IA (/api/chat) ---------------------------------
# SEM a chave, o chat funciona em modo curado (respostas seguras, sem custo).
# COM a chave, usa Claude (tem custo por mensagem). Obtenha em console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."
